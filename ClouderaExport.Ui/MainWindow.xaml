<Window x:Class="ClouderaExport.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClouderaExport.Ui.ViewModels"
        xmlns:helpers="clr-namespace:ClouderaExport.Ui.Helpers"
        Title="Cloudera Export"
        Height="760" Width="1120"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="{Binding LogPanelHeight}" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="0">
            <!-- TAB 1: JOBS -->
            <TabItem Header="  Jobs  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Job Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Run & Job Action Buttons (Left) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="▶  Run Selected"
                                    Command="{Binding RunSelectedCommand}"
                                    Width="130" Height="28" Margin="0,0,8,0"
                                    Background="#E8F5E9" Foreground="#1B5E20"
                                    FontWeight="Bold" BorderBrush="#81C784"/>
                            <Button Content="⏩  Run All"
                                    Command="{Binding RunAllCommand}"
                                    Width="105" Height="28" Margin="0,0,16,0"
                                    Background="#E3F2FD" Foreground="#0D47A1"
                                    FontWeight="Bold" BorderBrush="#90CAF9"/>

                            <Rectangle Width="1" Fill="#CCCCCC" Margin="0,2,16,2"/>

                            <Button Content="+ Add Job" Command="{Binding AddJobCommand}" Width="90" Height="28" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <Button Content="Duplicate Job" Command="{Binding DuplicateJobCommand}" Width="105" Height="28" Margin="0,0,8,0"/>
                            <Button Content="Delete Job" Command="{Binding DeleteJobCommand}" Width="90" Height="28" Margin="0,0,8,0" Foreground="#C62828"/>
                            <Button Content="📂 Open Export Folder" Command="{Binding OpenExportFolderCommand}" Width="150" Height="28" Background="#FAFAFA"/>
                        </StackPanel>
                    </Grid>

                    <!-- Default Export Folder Bar -->
                    <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Default Export Folder:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#444" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding DefaultExportFolder, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseDefaultExportFolderCommand}" Width="75" Height="26" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Split View: DataGrid (Left) + Detail Editor (Right) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="320"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Jobs DataGrid -->
                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding Jobs}"
                                  SelectedItem="{Binding SelectedJob}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="Job Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140" FontWeight="Medium"/>
                                <DataGridTemplateColumn Header="Connection" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Connections, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValue="{Binding ConnectionId, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                <DataGridTextColumn Header="Split Rows" Binding="{Binding SplitRows, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="Base File Name" Binding="{Binding BaseFileName, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="Output Folder" Binding="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

                        <!-- Right: Selected Job Editor -->
                        <Border Grid.Column="2" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Job Details" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="Job Name:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedJob.Name, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,10"/>

                                    <CheckBox Content="Job Enabled" IsChecked="{Binding SelectedJob.Enabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" FontWeight="SemiBold"/>

                                    <TextBlock Text="Connection:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Connections}"
                                              SelectedValue="{Binding SelectedJob.ConnectionId, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="26" Margin="0,0,0,10"/>

                                    <TextBlock Text="Output Folder:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SelectedJob.OutputFolder, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Width="70" Height="26" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Content="Open" Command="{Binding OpenExportFolderCommand}" Width="55" Height="26" Margin="4,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="Base File Name:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedJob.BaseFileName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Export Format:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding AvailableFormats}"
                                                      SelectedItem="{Binding SelectedJob.Format, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Split Rows:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding SelectedJob.SplitRows, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="SQL / ODBC Query Text:" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedJob.QueryText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Height="160"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: CONNECTIONS -->
            <TabItem Header="  Connections  ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="190" MinHeight="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Connection Action Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Add Connection" Command="{Binding AddConnectionCommand}" Width="130" Height="28" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <Button Content="Delete Connection" Command="{Binding DeleteConnectionCommand}" Width="120" Height="28" Margin="0,0,8,0" Foreground="#C62828"/>
                        <Button Content="⚡ Test Connection" Command="{Binding TestConnectionCommand}" Width="130" Height="28" Background="#E8F5E9" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Connections DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Connections}"
                              SelectedItem="{Binding SelectedConnection}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" FontWeight="Medium"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Effective ODBC String (Masked)" Binding="{Binding EffectiveConnectionString}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Selected Connection Detail Card -->
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Connection Profile Editor" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Profile Name -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Profile Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedConnection.Name, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                </Grid>

                                <!-- Connection Type Dropdown -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Connection Type:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableConnectionTypes}"
                                              SelectedItem="{Binding SelectedConnection.Type, UpdateSourceTrigger=PropertyChanged}"
                                              Width="200" HorizontalAlignment="Left" Height="26"/>
                                </Grid>

                                <!-- DSN Section (Visible when Type == Dsn) -->
                                <StackPanel Visibility="{Binding SelectedConnection.IsDsn, Converter={StaticResource BoolToVis}}">
                                    <!-- DSN Name -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="DSN Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedConnection.DsnName, UpdateSourceTrigger=PropertyChanged}" Height="26"/>
                                    </Grid>

                                    <!-- Username & Password -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Username:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedConnection.Username, UpdateSourceTrigger=PropertyChanged}" Height="26"/>

                                        <TextBlock Grid.Column="3" Text="Password:  " VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <PasswordBox Grid.Column="4"
                                                     helpers:PasswordBoxHelper.BindPassword="True"
                                                     helpers:PasswordBoxHelper.BoundPassword="{Binding SelectedConnection.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="26"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Connection String Section (Visible when Type == ConnectionString) -->
                                <StackPanel Visibility="{Binding SelectedConnection.IsConnectionString, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Connection String:" VerticalAlignment="Top" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedConnection.RawConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="54"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Effective ODBC String Preview (Read-only) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Effective ODBC:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#444444"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SelectedConnection.EffectiveConnectionString, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#EEEEEE"
                                             Foreground="#333333"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Height="26"
                                             VerticalContentAlignment="Center"
                                             Padding="4,0"/>
                                </Grid>

                                <!-- Test Connection Button -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="⚡ Test Connection" Command="{Binding TestConnectionCommand}" Width="150" Height="28" Background="#E8F5E9" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Auto-Save Status Bar (now inside log panel row, removed from own row) -->

        <!-- Splitter: resizes ONLY between main content (Row 0) and log panel (Row 2) -->
        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="#CFCFCF"
                      ShowsPreview="True"
                      Cursor="SizeNS"
                      DragCompleted="LogSplitter_DragCompleted"/>

        <!-- Log Panel: Status bar + Output Log header + Output Log textbox all in one row -->
        <DockPanel Grid.Row="2" LastChildFill="True">

            <!-- Status bar docked at top -->
            <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="8,3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="#555"/>
                        <TextBlock Text="{Binding AutoSaveStatus}" Foreground="#007ACC" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⚙ Config Folder" Command="{Binding OpenConfigFolderCommand}" Margin="0,0,6,0" Padding="8,1" FontSize="11" Background="#FFFFFF" BorderBrush="#CCCCCC"/>
                        <Button Content="📄 Logs Folder" Command="{Binding OpenLogsFolderCommand}" Padding="8,1" FontSize="11" Background="#FFFFFF" BorderBrush="#CCCCCC"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Output Log label docked at top -->
            <Border DockPanel.Dock="Top" Background="#ECEFF1" Padding="6,2">
                <TextBlock Text="Output Log" FontSize="11" FontWeight="Bold" Foreground="#37474F"/>
            </Border>

            <!-- Output Log fills remainder -->
            <TextBox x:Name="LogConsoleBox"
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="#263238"
                     Foreground="#ECEFF1"
                     BorderThickness="0"
                     TextChanged="LogConsoleBox_TextChanged"/>
        </DockPanel>
    </Grid>
</Window>

